# Copy to .env and fill in your values

# ── Global LLM defaults (used when agent has no override) ─────────────────────
AGENT_BACKEND=anthropic        # anthropic | ollama | lmstudio
AGENT_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=sk-ant-...
# AGENT_BASE_URL=http://localhost:11434/v1

# ── Per-agent overrides (all optional — fall back to global if unset) ──────────
#
# Example: Architect uses Claude Opus (smart planner),
#          Coder/Tester use a local Ollama model (fast + free),
#          Reviewer uses Claude Sonnet (balanced).
#
# ARCHITECT_BACKEND=anthropic
# ARCHITECT_MODEL=claude-opus-4-6
# ARCHITECT_API_KEY=sk-ant-...        # own key if needed

# CODER_BACKEND=ollama
# CODER_MODEL=qwen2.5:14b
# CODER_BASE_URL=http://localhost:11434/v1

# TESTER_BACKEND=ollama
# TESTER_MODEL=qwen2.5:7b
# TESTER_BASE_URL=http://localhost:11434/v1

# REVIEWER_BACKEND=anthropic
# REVIEWER_MODEL=claude-sonnet-4-20250514
# REVIEWER_API_KEY=sk-ant-...

# ── Pipeline behaviour ────────────────────────────────────────────────────────
AGENT_MAX_STEPS=25             # max tool-call iterations per agent
AGENT_MAX_ITERATIONS=3         # max Coder→Tester→Reviewer loops
AGENT_STREAM_TOKENS=true       # stream tokens in real time

# ── Paths ─────────────────────────────────────────────────────────────────────
AGENT_WORKSPACE=./workspace

# ── Web server ────────────────────────────────────────────────────────────────
AGENT_HOST=127.0.0.1
AGENT_PORT=8000

# ── Sandbox (Docker isolation for run_command) ────────────────────────────────
# auto   = use Docker if available, fallback to direct subprocess
# true   = always use Docker (fails if Docker not running)
# false  = always direct subprocess (no isolation)
SANDBOX_ENABLED=auto
SANDBOX_IMAGE=python:3.12-slim   # image used inside sandbox
SANDBOX_MEMORY=512m              # memory limit per command
SANDBOX_CPUS=1.0                 # CPU limit
SANDBOX_NETWORK=none             # none = no internet; bridge = internet allowed
SANDBOX_TIMEOUT=120              # seconds before hard kill

# ── Supervisor ────────────────────────────────────────────────────────────────
SUPERVISOR_MAX_RETRIES=2         # retries per agent on failure
SUPERVISOR_TIMEOUT=300           # seconds before killing an agent
SUPERVISOR_MIN_OUTPUT=10         # minimum output chars to pass quality gate

# ── Plugins ───────────────────────────────────────────────────────────────────
# Drop .py files into plugins/ — they're auto-discovered on startup
# Hot-reload: POST /api/plugins/reload or click "Reload" in UI
