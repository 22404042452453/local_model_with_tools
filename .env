# ── Global defaults ───────────────────────────────────────────────────────────
AGENT_BACKEND=ollama
AGENT_MODEL=qwen-agent
AGENT_BASE_URL=http://localhost:11434/v1

# ── Per-agent ─────────────────────────────────────────────────────────────────
ARCHITECT_MODEL=qwen3.5:9b
CODER_MODEL=qwen-agent
TESTER_MODEL=qwen-agent
REVIEWER_MODEL=qwen3.5:9b

# ── Pipeline ──────────────────────────────────────────────────────────────────
AGENT_MAX_STEPS=25
AGENT_MAX_ITERATIONS=10
AGENT_STREAM_TOKENS=true
AGENT_WORKSPACE=./workspace

# ── Web server ────────────────────────────────────────────────────────────────
AGENT_HOST=127.0.0.1
AGENT_PORT=8000

# ── Sandbox ───────────────────────────────────────────────────────────────────
SANDBOX_ENABLED=auto
SANDBOX_IMAGE=python:3.12-slim   # image used inside sandbox
SANDBOX_MEMORY=512m              # memory limit per command
SANDBOX_CPUS=1.0                 # CPU limit
SANDBOX_NETWORK=none             # none = no internet; bridge = internet allowed
SANDBOX_TIMEOUT=300              # seconds before hard kill

# ── Supervisor ────────────────────────────────────────────────────────────────
SUPERVISOR_MAX_RETRIES=3         # retries per agent on failure
SUPERVISOR_TIMEOUT=100           # seconds before killing an agent
SUPERVISOR_MIN_OUTPUT=10         # minimum output chars to pass quality gate
